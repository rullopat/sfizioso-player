{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "sfizioso.instrument-manifest"
    },
    "formatVersion": {
      "const": 1,
      "type": "integer"
    },
    "instrument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 4096
        },
        "name": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "author": {
          "type": "string",
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "name"
      ]
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1
          },
          "name": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1
          },
          "sfz": {
            "allOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1,
                "pattern": "^(?!/)(?!.*[\\\\:%?#\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
              },
              {
                "pattern": "\\.[sS][fF][zZ]$"
              }
            ]
          },
          "category": {
            "type": "string",
            "maxLength": 4096
          },
          "author": {
            "type": "string",
            "maxLength": 4096
          },
          "artwork": {
            "type": "object",
            "properties": {
              "controlsBackground": {
                "allOf": [
                  {
                    "type": "string",
                    "maxLength": 4096,
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*[\\\\:%?#\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
                  },
                  {
                    "pattern": "\\.(?:[pP][nN][gG]|[jJ][pP][eE]?[gG])$"
                  }
                ]
              }
            },
            "required": []
          },
          "presentation": {
            "type": "object",
            "properties": {
              "accent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "sections": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 4096,
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "controls": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "object",
                        "properties": {
                          "target": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "const": "cc"
                              },
                              "number": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 127
                              }
                            },
                            "required": [
                              "type",
                              "number"
                            ]
                          },
                          "label": {
                            "type": "string",
                            "maxLength": 4096
                          },
                          "widget": {
                            "enum": [
                              "knob",
                              "slider",
                              "toggle"
                            ]
                          }
                        },
                        "required": [
                          "target"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "controls"
                  ]
                }
              }
            },
            "required": []
          }
        },
        "required": [
          "id",
          "name",
          "sfz"
        ]
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "instrument",
    "presets"
  ]
}
